/* GENERATED from tokens.yaml — do not edit. WeasyPrint print stylesheet. */
{% include '_vars.css.j2' %}
@page {
  size: {{ print.page_size }};
  margin: {{ print.margin }};
  @bottom-left { content: "{{ print.footer_text }}"; font: 8pt var(--ig-font-body); color: {{ color.muted }}; }
  @bottom-right { content: counter(page) " / " counter(pages); font: 8pt var(--ig-font-body); color: {{ color.muted }}; }
}
@page :first { @bottom-left { content: none; } }
html { font-family: var(--ig-font-body); font-size: {{ font.base_size_pt }}pt; color: var(--ig-ink); line-height: 1.45; }
header.doc-header { border-bottom: 3pt solid var(--ig-primary); padding-bottom: 8pt; margin-bottom: 18pt; display: flex; align-items: center; gap: 12pt; }
header.doc-header img { height: 36pt; }
header.doc-header .meta { color: var(--ig-muted); font-size: 8.5pt; }
h1, h2, h3, h4 { font-family: var(--ig-font-heading); color: var(--ig-ink); break-after: avoid; }
h1 { font-size: 22pt; margin: 0; }
h2 { font-size: 14pt; color: var(--ig-primary-dark); border-bottom: 0.75pt solid var(--ig-border); padding-bottom: 3pt; margin-top: 18pt; }
h3 { font-size: 11.5pt; }
a { color: var(--ig-primary-dark); text-decoration: none; }
code, pre { font-family: var(--ig-font-mono); font-size: 0.88em; background: var(--ig-surface-alt); border-radius: 3pt; }
pre { padding: 8pt; break-inside: avoid; white-space: pre-wrap; }
table { border-collapse: collapse; width: 100%; break-inside: avoid; font-size: 9.5pt; }
th { background: var(--ig-ink); color: var(--ig-surface); text-align: left; }
th, td { padding: 4pt 6pt; border-bottom: 0.5pt solid var(--ig-border); }
tr:nth-child(even) td { background: var(--ig-surface-alt); }
img { max-width: 100%; }
.callout { border-left: 3pt solid var(--ig-info); background: var(--ig-surface-alt); padding: 6pt 10pt; margin: 10pt 0; border-radius: 0 3pt 3pt 0; break-inside: avoid; }
.callout-title { font-weight: 700; margin-bottom: 3pt; }
.callout-warning, .callout-caution { border-color: var(--ig-warning); }
.callout-danger, .callout-error { border-color: var(--ig-danger); }
.callout-tip, .callout-success { border-color: var(--ig-success); }
